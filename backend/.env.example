# Copy to backend/.env and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Local SQLite (no services needed):
DATABASE_URL=sqlite+aiosqlite:///./taskflow.db
# Local Postgres via docker compose:
# DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow
# Neon: paste the connection string as-is. database.py forces the +asyncpg
# driver, enables SSL, and strips the libpq-only args (sslmode, channel_binding)
# that asyncpg rejects.
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/taskflow?sslmode=require
SQL_ECHO=false

# --- Auth (Contract 1) ------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# The refresh cookie. In production (Vercel UI on a different origin to the
# Render API) this must be COOKIE_SECURE=true and COOKIE_SAMESITE=none, or the
# browser will not send it cross-site.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/api/auth
COOKIE_DOMAIN=

# --- CORS and WebSocket origins (Contract 8) --------------------------------
# Comma-separated, explicit. "*" is illegal with credentialed CORS and is
# ignored if present. This same list is what the WebSocket handshake checks its
# Origin header against — CORS middleware does not protect the /ws endpoint.
# In production, include the Vercel production domain AND the preview domains.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browsers always send Origin; websocat and the test suite do not. Set false to
# require one on every WebSocket handshake.
WS_ALLOW_MISSING_ORIGIN=true

# --- Realtime (Contract 6) --------------------------------------------------
WS_TICKET_TTL_SECONDS=30
WS_PING_INTERVAL_SECONDS=25
WS_SEND_TIMEOUT_SECONDS=5
