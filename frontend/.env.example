# ---------------------------------------------------------------------------
# TaskFlow frontend configuration
# ---------------------------------------------------------------------------

# Base URL for HTTP API calls. Leave EMPTY in dev to use the Vite proxy in
# vite.config.ts (same-origin -> the refresh cookie just works). In production
# set it to the Render API origin, e.g. https://taskflow-api.onrender.com
VITE_API_BASE=

# WebSocket origin (Contract 6 §1). The browser connects to the API origin
# DIRECTLY -- Vercel does not proxy WebSockets, so in production this is the
# Render host and is NOT the origin the app was served from.
#   dev:  ws://localhost:8000
#   prod: wss://taskflow-api.onrender.com
VITE_WS_BASE=ws://localhost:8000

# Stub toggles. Both default to off; set to "true" to develop without a backend.
# VITE_USE_MOCKS serves Contracts 1-5 and 8 from src/api/mocks.ts.
# VITE_USE_FAKE_SOCKET replaces the native WebSocket with src/realtime/fakeSocket.ts.
VITE_USE_MOCKS=false
VITE_USE_FAKE_SOCKET=false
